# ===== Hub (PC principal) =====
MYBOTS_HUB_PORT=8790
# Token único aceito de qualquer nó (gere um aleatório). Ou use MYBOTS_NODE_TOKENS=bot1:token1,bot2:token2
MYBOTS_HUB_TOKEN=troque-por-um-token-grande
# Senha opcional da interface (vazio = sem senha; só use sem senha na LAN)
MYBOTS_UI_PASSWORD=
# Seu nome, como os bots devem te chamar
MYBOTS_USER_NAME=Thiago

# ===== Nó (cada PC de bot) — normalmente fica em bots/<bot>/.env =====
# MYBOTS_HUB=ws://192.168.0.10:8790
# MYBOTS_NODE_TOKEN=o-mesmo-token-do-hub
# Chaves de modelo (só a do provedor que você usa):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# NOUS_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=            (só para OpenCode Zen pago; os modelos grátis não precisam de chave)
# OPENCODE_SERVER_PASSWORD=    (senha do opencode serve local; o instalador gera uma)

# --- Imagem sem GPU (grátis) ---
# Pollinations: funciona sem nada configurado. O token e opcional: tira a marca d'agua
# e o limite anonimo de 1 pedido a cada 15 s (pegue em auth.pollinations.ai).
# MYBOTS_POLLINATIONS_TOKEN=
# MYBOTS_POLLINATIONS_MODEL=flux
# Cloudflare Workers AI: camada gratis (~230 imagens/dia), conta sem cartao.
# MYBOTS_CLOUDFLARE_ACCOUNT_ID=
# MYBOTS_CLOUDFLARE_API_TOKEN=
# Ordem dos provedores (o padrao ja e o de cima para baixo, gratis primeiro):
# MYBOTS_MEDIA_ORDER=pollinations,cloudflare,comfy,gemini,openai

# Roleta de cotas grátis — o cliente põe aqui as chaves dele (as que tiver).
# Ver docs/PROVEDORES.md. Sem nenhuma, o sistema cai no Ollama desta máquina.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
NOUS_API_KEY=
# Mistral: o tier grátis exige aceitar que os dados treinem o modelo.
# Só marque sim se o dono da empresa decidiu isso por escrito.
MISTRAL_CONSENTIMENTO_TREINO=nao
ZAI_API_KEY=
